generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash")
  role         String        @default("staff") @db.VarChar(20) // Database constraint: admin or staff
  appointments Appointment[] @relation("AppointmentCreatedBy")

  @@map("users")
}

model Patient {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(255)
  cin          String        @unique @db.VarChar(50)
  phone        String        @db.VarChar(50)
  birthDate    DateTime      @map("birth_date") @db.Date
  address      String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  appointments Appointment[]

  @@map("patients")
}

model Appointment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  appointmentDate DateTime @map("appointment_date") @db.Timestamptz(6)
  status          String   @default("pending") @db.VarChar(20) // Database constraint: pending, confirmed, or cancelled
  reason          String
  notes           String?
  createdBy       String   @map("created_by") @db.Uuid
  patient         Patient  @relation(fields: [patientId], references: [id])
  creator         User     @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])

  @@index([patientId], map: "appointments_patient_id_idx")
  @@index([createdBy], map: "appointments_created_by_idx")
  @@index([appointmentDate], map: "appointments_appointment_date_idx")
  @@index([status], map: "appointments_status_idx")
  @@map("appointments")
}
